# ===== FRONTEND (Vercel Environment Variables) =====
# URL base de la API del backend (sin trailing slash)
VITE_API_URL=https://culturas-backend.railway.app

# ===== BACKEND (Django Environment Variables) =====
# Django Security
DJANGO_SECRET_KEY=your-secure-secret-key-here-minimum-50-chars
DEBUG=False
ALLOWED_HOSTS=culturas-backend.railway.app,www.culturas-backend.railway.app,localhost,127.0.0.1

# Database (PostgreSQL en producción)
DATABASE_URL=postgresql://user:password@localhost:5432/culturas

# CORS - Permitir requests desde el frontend
CORS_ALLOWED_ORIGINS=https://culturas-mse8.vercel.app,https://www.culturas.com,http://localhost:5173,http://127.0.0.1:5173

# AI API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ===== NOTAS =====
# En desarrollo local: usa localhost:8000 para backend y 5173 para frontend
# En producción: actualiza las URLs con tus dominios reales
# NUNCA commitees .env con valores reales - usa .env.local localmente
